@page "/"
@rendermode InteractiveServer
@using Library

<PageTitle>Tic-Tac-Toe</PageTitle>

@if (_board.Status == GameStatus.SymbolSelection)
{
    <MudStack AlignItems="AlignItems.Center" Spacing="4" Class="mt-8">
        <MudText Typo="Typo.h4">Choose X or O</MudText>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" OnClick="@(() => StartGame('X'))">X</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Large" OnClick="@(() => StartGame('O'))">O</MudButton>
        </MudStack>
    </MudStack>
}
else
{
    <MudStack AlignItems="AlignItems.Center" Spacing="4" Class="mt-8">
        <MudText Typo="Typo.h5">@StatusText</MudText>

        <MudGrid Style="width:300px;">
            @for (int row = 0; row < 3; row++)
            {
                @for (int col = 0; col < 3; col++)
                {
                    int i = row * 3 + col;
                    bool isEnabled = _board.Status == GameStatus.Active && _board.IsPlayerTurn && _board.Cells[i] == '\0';
                    <MudItem xs="4" Style="padding:4px;">
                        <MudButton @key="i"
                                   Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   FullWidth="true"
                                   Style="height:90px; font-size:2rem; font-weight:bold;"
                                   Disabled="@(!isEnabled)"
                                   OnClick="@(() => PlayerClickCell(i))">
                            @CellDisplay(_board.Cells[i])
                        </MudButton>
                    </MudItem>
                }
            }
        </MudGrid>

        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => _board.Reset())">Restart</MudButton>
    </MudStack>
}

@code {
    private GameBoard _board = new();

    private string CellDisplay(char c) => c == '\0' ? "" : c.ToString();

    private string StatusText => _board.Status switch
    {
        GameStatus.Active => "Your turn",
        GameStatus.PlayerWon => "You win",
        GameStatus.ComputerWon => "Computer wins",
        GameStatus.Draw => "Draw",
        _ => ""
    };

    private void StartGame(char playerSymbol)
    {
        _board.Reset();
        _board.PlayerSymbol = playerSymbol;
        _board.ComputerSymbol = playerSymbol == 'X' ? 'O' : 'X';
        _board.Status = GameStatus.Active;
        _board.IsPlayerTurn = true;
    }

    private void PlayerClickCell(int i)
    {
        if (_board.Status != GameStatus.Active || !_board.IsPlayerTurn || _board.Cells[i] != '\0')
            return;

        _board.Cells[i] = _board.PlayerSymbol;
        _board.IsPlayerTurn = false;
        _board.Status = GameRules.CheckResult(_board.Cells, _board.PlayerSymbol, _board.ComputerSymbol);
        if (_board.Status == GameStatus.Active)
        {
            // CheckResult returned Active, so at least one empty cell exists.
            int computerCell = ComputerPlayer.PickCell(_board.Cells);
            _board.Cells[computerCell] = _board.ComputerSymbol;
            _board.Status = GameRules.CheckResult(_board.Cells, _board.PlayerSymbol, _board.ComputerSymbol);
            if (_board.Status == GameStatus.Active)
                _board.IsPlayerTurn = true;
        }
    }
}
